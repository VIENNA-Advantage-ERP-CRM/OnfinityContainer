# Shared config for the two-host deployment - copy this file to BOTH hosts as
# `.env` (not `.env.example`) and fill in real values there. `.env` is
# gitignored on purpose so real credentials never end up in git history.
#
#   Linux host   (docker-compose.linux.yml)   uses: POSTGRES_USER,
#                POSTGRES_PASSWORD, POSTGRES_DB, DB_PORT
#   Windows host (docker-compose.windows.yml) uses: all of the above, plus
#                POSTGRES_HOST and WEB_PORT

# Address of the Linux host running docker-compose.linux.yml - e.g. its LAN
# IP (192.168.1.50) or hostname. Required on the Windows host; ignored on
# the Linux host itself. No default on purpose - it's always a different
# machine, so a working-looking default here would just hide a
# misconfiguration.
POSTGRES_HOST=

POSTGRES_USER=viennacrmuser
POSTGRES_PASSWORD=changeme
POSTGRES_DB=onfinitydb
DB_PORT=5432

# Web Application (Windows host only)
WEB_PORT=8080
ASPNETCORE_ENVIRONMENT=Production
