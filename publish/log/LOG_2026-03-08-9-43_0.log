09:52:57.525    (INFO)     ConvertSQL.ApplyConvertMap: [31]Exception clause needs to be converted: create or replace PROCEDURE M_PRODUCTION_RUN( PInstance_ID IN NUMBER ) AS ResultStr VARCHAR2(2000); MESSAGE VARCHAR2(2000); Record_ID NUMBER; CURSOR Cur_Parameter (PInstance NUMBER) IS SELECT i.Record_ID, p.ParameterName, p.P_String, p.P_Number, p.P_Date FROM AD_PInstance i, AD_PInstance_Para p WHERE i.AD_PInstance_ID=PInstance AND i.AD_PInstance_ID =p.AD_PInstance_ID(+) ORDER BY p.SeqNo; MustBeStocked CHAR(1); IsCreated CHAR(1); Processed CHAR(1); Client_ID NUMBER; Org_ID NUMBER; Line NUMBER; NextNo NUMBER; CountNo NUMBER; lockCount NUMBER; ValidPP CHAR(1); CURSOR CUR_PP IS SELECT pp.Ad_Client_ID, pp.Ad_Org_ID, pp.Description, pp.IsActive, pp.Line, pp.M_Locator_ID, pp.M_Product_ID, pp.M_ProductionPlan_ID, pp.M_Production_ID, pp.Processed, pp.ProductionQty, prod.C_UOM_ID FROM M_ProductionPlan pp, M_Product prod WHERE pp.M_Production_ID=Record_ID AND prod.M_Product_ID = pp.M_Product_ID AND prod.IsBOM = 'Y' AND prod.IsVerified = 'Y' AND prod.IsStocked = 'Y' ORDER BY Line, M_Product_ID; CURSOR CUR_BOM (Product_ID NUMBER) IS SELECT bp.M_ProductBOM_ID, bp.BOMQty, bp.Line, (SELECT pp.C_UOM_ID FROM M_Product pp WHERE pp.M_Product_ID=bp.M_ProductBOM_ID ) AS C_UOM_ID FROM M_Product p, M_BOM b, M_BOMProduct bp WHERE p.M_Product_ID = Product_ID AND p.IsBOM = 'Y' AND p.IsVerified = 'Y' AND b.M_Product_ID = p.M_Product_ID AND bp.M_BOM_ID = b.M_BOM_ID AND bp.IsActive = 'Y' AND b.BOMType = 'A' AND b.BOMUse = 'A' AND b.IsActive = 'Y' ORDER BY bp.Line; CURSOR CUR_PLineBOM (ProductionPlan_ID NUMBER) IS SELECT pl.M_ProductionLine_ID, pl.Line, pl.M_Product_ID, pl.MovementQty FROM M_ProductionLine pl, M_Product p WHERE pl.M_ProductionPlan_ID=ProductionPlan_ID AND pl.M_Product_ID =p.M_Product_ID AND pl.Line <>100 AND p.IsBOM ='Y' AND p.IsStocked ='N' AND p.IsVerified ='Y'; CURSOR CUR_PL_Post IS SELECT pl.M_ProductionLine_ID, pl.AD_Client_ID, pl.AD_Org_ID, p.MovementDate, pl.M_Product_ID, pl.M_AttributeSetInstance_ID, pl.MovementQty, pl.M_Locator_ID, wh.IsDisallowNegativeInv FROM M_Production p, M_ProductionLine pl , M_ProductionPlan pp , M_Product prod, M_Locator loc, M_Warehouse wh WHERE p.M_Production_ID =pp.M_Production_ID AND pp.M_ProductionPlan_ID=pl.M_ProductionPlan_ID AND pp.M_Production_ID =Record_ID AND pl.M_Product_ID =prod.M_Product_ID AND prod.ProductType ='I' AND pl.M_Locator_ID = loc.M_Locator_ID AND loc.M_Warehouse_ID = wh.M_Warehouse_ID ORDER BY pp.Line, pl.Line; BEGIN DBMS_OUTPUT.PUT_LINE('Updating PInstance - Processing ' || PInstance_ID); ResultStr := 'PInstanceNotFound'; UPDATE AD_PInstance SET Created = SysDate, IsProcessing = 'Y' WHERE AD_PInstance_ID=PInstance_ID; COMMIT; ResultStr := 'ReadingParameters'; FOR p IN Cur_Parameter (PInstance_ID) LOOP Record_ID := p.Record_ID; IF (p.ParameterName = 'MustBeStocked') THEN MustBeStocked := p.P_String; DBMS_OUTPUT.PUT_LINE(' MustBeStocked=' || MustBeStocked); ELSE DBMS_OUTPUT.PUT_LINE('*** Unknown Parameter=' || p.ParameterName); END IF; END LOOP; DBMS_OUTPUT.PUT_LINE(' Record_ID=' || Record_ID); /** * Get Info + Lock */ ResultStr := 'ReadingRecord'; SELECT IsCreated, Processed, AD_Client_ID, AD_Org_ID INTO IsCreated, Processed, Client_ID, Org_ID FROM M_Production WHERE M_Production_ID=Record_ID FOR UPDATE; /** * No Action */ IF (Processed <> 'N') THEN MESSAGE := '@AlreadyPosted@'; GOTO FINISH_PROCESS; END IF; /************************************************************************** * Create Lines */ IF (IsCreated <> 'Y') THEN ValidPP := 'N'; FOR pp IN CUR_PP LOOP ValidPP := 'Y'; DELETE M_ProductionLine WHERE M_ProductionPlan_ID=pp.M_ProductionPlan_ID; ResultStr := 'CreatingLine BOM'; Line := 100; AD_Sequence_Next('M_ProductionLine', pp.AD_Client_ID, NextNo); INSERT INTO M_ProductionLine ( M_ProductionLine_ID, M_ProductionPlan_ID, Line , AD_Client_ID , AD_Org_ID , IsActive, Created , CreatedBy , Updated , UpdatedBy, M_Product_ID, MovementQty, M_Locator_ID , Description, PlannedQty, C_UOM_ID ) VALUES ( NextNo , pp.M_ProductionPlan_ID, Line , pp.AD_Client_ID , pp.AD_Org_ID , 'Y' , SysDate , 0 , SysDate , 0 , pp.M_Product_ID , pp.ProductionQty , pp.M_Locator_ID , pp.Description, pp.ProductionQty, pp.C_UOM_ID ); FOR bom IN CUR_BOM ( pp.M_Product_ID ) LOOP ResultStr := 'CreatingLine Products'; Line := Line + 100; AD_Sequence_Next ( 'M_ProductionLine', pp.AD_Client_ID, NextNo ) ; INSERT INTO M_ProductionLine ( M_ProductionLine_ID, M_ProductionPlan_ID, Line , AD_Client_ID , AD_Org_ID , IsActive , Created , CreatedBy , Updated , UpdatedBy , M_Product_ID , MovementQty , M_Locator_ID, PlannedQty, C_UOM_ID ) VALUES ( NextNo , pp.M_ProductionPlan_ID , Line , pp.AD_Client_ID , pp.AD_Org_ID , 'Y' , SysDate, 0, SysDate , 0, bom.M_ProductBOM_ID, -pp.ProductionQty*bom.BOMQty, pp.M_Locator_ID, -pp.ProductionQty*bom.BOMQty, bom.C_UOM_ID ); END LOOP; LOOP ResultStr := 'CreatingLine CheckBOM'; SELECT COUNT(*) INTO CountNo FROM M_ProductionLine pl, M_Product p WHERE pl.M_Product_ID =p.M_Product_ID AND pl.M_ProductionPlan_ID=pp.M_ProductionPlan_ID AND pl.Line <>100 AND p.IsBOM ='Y' AND p.IsStocked ='N' AND p.IsVerified ='Y'; EXIT WHEN (CountNo = 0); FOR pl IN CUR_PLineBOM (pp.M_ProductionPlan_ID) LOOP ResultStr := 'CreatingLineBOM Resolution'; Line := pl.Line; FOR bom IN CUR_BOM (pl.M_Product_ID) LOOP ResultStr := 'CreatingLine Products2'; Line := Line + 10; AD_Sequence_Next('M_ProductionLine', pp.AD_Client_ID, NextNo); INSERT INTO M_ProductionLine ( M_ProductionLine_ID, M_ProductionPlan_ID, Line , AD_Client_ID, AD_Org_ID , IsActive , Created, CreatedBy, Updated, UpdatedBy, M_Product_ID , MovementQty , M_Locator_ID, PlannedQty, C_UOM_ID ) VALUES ( NextNo , pp.M_ProductionPlan_ID , Line, pp.AD_Client_ID , pp.AD_Org_ID , 'Y' , SysDate , 0 , SysDate , 0 , bom.M_ProductBOM_ID , pl.MovementQty*bom.BOMQty, pp.M_Locator_ID, pl.MovementQty*bom.BOMQty, bom.C_UOM_ID ); END LOOP; DELETE M_ProductionLine WHERE M_ProductionLine_ID=pl.M_ProductionLine_ID; END LOOP; END LOOP; END LOOP; IF (ValidPP = 'Y') THEN UPDATE M_Production SET IsCreated='Y' WHERE M_Production_ID=Record_ID; ELSE MESSAGE := '@StockedBOM@'; RAISE NO_DATA_FOUND; END IF; /************************************************************************** * Post Lines */ ELSE FOR pl IN CUR_PL_Post LOOP lockCount :=0; SELECT COUNT(1) INTO lockCount FROM VAMFG_M_CycleCount l WHERE l.M_Product_ID = pl.M_Product_ID AND l.M_Locator_ID = pl.M_Locator_ID AND l.VAMFG_IsLocked = 'Y'; IF (lockCount >0 ) THEN ROLLBACK; SELECT 'Product' || NAME ||' Locked for transaction ' INTO MESSAGE FROM M_Product WHERE M_Product_ID=pl.M_Product_ID; GOTO FINISH_PROCESS; END IF; IF (pl.MovementQty < 0 AND MustBeStocked <> 'N' AND bomQtyOnHand(pl.M_Product_ID, NULL, pl.M_Locator_ID)+pl.MovementQty < 0) THEN ROLLBACK; SELECT '@NotEnoughStocked@: ' || Name INTO MESSAGE FROM M_Product WHERE M_Product_ID=pl.M_Product_ID; GOTO FINISH_PROCESS; END IF; IF (pl.MovementQty < 0 AND pl.IsDisallowNegativeInv = 'Y' AND bomQtyOnHand(pl.M_Product_ID, NULL, pl.M_Locator_ID)+pl.MovementQty < 0) THEN ROLLBACK; MESSAGE := '@NegativeInventoryDisallowed@ '; GOTO FINISH_PROCESS; END IF; UPDATE M_Storage SET qtyonhand = qtyonhand + pl.MovementQty, Updated = SysDate WHERE M_Locator_ID = pl.M_Locator_ID AND M_AttributeSetInstance_ID = COALESCE(pl.M_AttributeSetInstance_ID,0) AND M_Product_ID = pl.M_Product_ID; IF (SQL%ROWCOUNT = 0) THEN INSERT INTO M_Storage ( M_Product_ID , M_Locator_ID , M_AttributeSetInstance_ID, AD_Client_ID , AD_Org_ID , IsActive , Created , CreatedBy , Updated , UpdatedBy , qtyonhand ) VALUES ( pl.M_Product_ID , pl.M_Locator_ID , COALESCE(pl.M_AttributeSetInstance_ID,0), pl.AD_Client_ID , pl.AD_Org_ID , 'Y' , SysDate , 0 , SysDate , 0 , pl.MovementQty ); END IF; ResultStr := 'CreateTransaction'; AD_Sequence_Next ( 'M_Transaction', pl.AD_Org_ID, NextNo ) ; INSERT INTO M_Transaction ( M_Transaction_ID , M_ProductionLine_ID , AD_Client_ID , AD_Org_ID , IsActive , Created , CreatedBy , Updated , UpdatedBy , MovementType , M_Locator_ID , M_Product_ID , M_AttributeSetInstance_ID, MovementDate , MovementQty ) VALUES ( NextNo , pl.M_ProductionLine_ID , pl.AD_Client_ID , pl.AD_Org_ID , 'Y' , SysDate , 0 , SysDate , 0 , 'P+' , pl.M_Locator_ID , pl.M_Product_ID , COALESCE(pl.M_AttributeSetInstance_ID,0), pl.MovementDate , pl.MovementQty ); END LOOP; UPDATE M_ProductionLine SET Processed ='Y' WHERE M_ProductionPlan_ID= (SELECT M_ProductionPlan_ID FROM M_ProductionPlan WHERE M_Production_ID=Record_ID ); UPDATE M_Production SET Processed='Y' WHERE M_Production_ID=Record_ID; UPDATE M_ProductionPlan SET Processed='Y' WHERE M_Production_ID=Record_ID; END IF; COMMIT; <<FINISH_PROCESS>> DBMS_OUTPUT.PUT_LINE('Updating PInstance - Finished ' || MESSAGE); UPDATE AD_PInstance SET Updated = SysDate, IsProcessing = 'N' , Result = 1 , ErrorMsg = MESSAGE WHERE AD_PInstance_ID=PInstance_ID; COMMIT; RETURN; EXCEPTION WHEN OTHERS THEN ResultStr := ResultStr || ': ' || SQLERRM || ' - ' || MESSAGE; DBMS_OUTPUT.PUT_LINE(ResultStr); UPDATE AD_PInstance SET Updated = SysDate, IsProcessing = 'N', Result = 0 , ErrorMsg = ResultStr WHERE AD_PInstance_ID=PInstance_ID; COMMIT; RETURN; END M_PRODUCTION_RUN;
