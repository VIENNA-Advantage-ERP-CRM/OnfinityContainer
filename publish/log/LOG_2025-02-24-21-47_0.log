meric, BOM_ID numeric) for select bp.M_ProductBOM_ID, bp.BOMQty, bp.Line, ( select pp.C_UOM_ID from M_Product pp where pp.M_Product_ID = bp.M_ProductBOM_ID ) as C_UOM_ID, ( select pp.Name from M_Product pp where pp.M_Product_ID = bp.M_ProductBOM_ID ) as Name, bp.M_AttributeSetInstance_ID as CompASI, b.VAS_IsReverseAssembly, bp.VAS_IsProportionateCost from M_Product p, M_BOM b, M_BOMProduct bp where p.M_Product_ID = Product_ID and b.M_BOM_ID = BOM_ID and p.IsBOM = 'Y' and p.IsVerified = 'Y' and b.M_Product_ID = p.M_Product_ID and bp.M_BOM_ID = b.M_BOM_ID and bp.IsActive = 'Y' and b.BOMType = 'A' and b.BOMUse = 'A' and b.IsActive = 'Y' order by bp.Line; CUR_PLineBOM cursor(ProductionPlan_ID numeric) for select pl.M_ProductionLine_ID, pl.Line, pl.M_Product_ID, pl.MovementQty from M_ProductionLine pl, M_Product p where pl.M_ProductionPlan_ID = ProductionPlan_ID and pl.M_Product_ID = p.M_Product_ID and pl.Line <> 100 and p.IsBOM = 'Y' and p.IsVerified = 'Y'; CUR_PL_Post cursor is select pl.M_ProductionLine_ID, pl.AD_Client_ID, pl.AD_Org_ID, p.MovementDate, pl.M_Product_ID, pl.M_AttributeSetInstance_ID, pl.MovementQty, pl.M_Locator_ID, wh.IsDisallowNegativeInv, pl.M_Warehouse_ID, prod.m_attributeset_id, pp.M_Product_ID as PlanProduct_ID, pp.M_AttributeSetInstance_ID as PlanAttribute_ID, pp.VAS_IsReverseAssembly, pp.ProductionQty, prod.Name from M_Production p inner join M_ProductionPlan pp on pp.M_Production_id = pp.M_Production_id inner join M_ProductionLine pl on pl.M_ProductionPlan_id = pp.M_ProductionPlan_id inner join M_Product prod on pl.M_Product_id = prod.M_Product_id inner join M_Locator loc on loc.M_Locator_id = pl.M_Locator_id inner join M_Warehouse wh on loc.M_Warehouse_id = wh.M_Warehouse_id where p.M_Production_ID = pp.M_Production_ID and pp.M_ProductionPlan_ID = pl.M_ProductionPlan_ID and pp.M_Production_ID = Record_ID and pl.M_Product_ID = prod.M_Product_ID and prod.ProductType = 'I' and pl.M_Locator_ID = loc.M_Locator_ID and loc.M_Warehouse_ID = wh.M_Warehouse_ID order by pl.movementqty asc, pl.VAS_IsProportionateCost asc, pp.Line, pl.Line; cur_attr cursor( product_id numeric ) for select count(p.m_product_id) as atrcnt from m_product p left join M_AttributeSet ast on (p.M_AttributeSet_ID = ast.M_AttributeSet_ID) where p.m_product_id = product_id and (IsLotMandatory = 'Y' or IsSerNoMandatory = 'Y' or IsGuaranteeDateMandatory = 'Y' or MandatoryType = 'Y') and ast.isactive = 'Y'; bom RECORD; isGotoExit BOOLEAN := 'f'; begin raise notice 'Updating PInstance - Processing %', PInstance_ID; ResultStr := 'PInstanceNotFound'; update AD_PInstance set Created = CURRENT_DATE, IsProcessing = 'Y' where AD_PInstance_ID = PInstance_ID; ResultStr := 'ReadingParameters'; for p in Cur_Parameter(PInstance_ID) loop Record_ID := p.Record_ID; raise notice 'RecordId: %', Record_ID; select case when coalesce(m_ref_production, '') != '' then m_ref_production::numeric else m_production_id end into strict Record_ID from m_production where M_Production_ID = Record_ID; if (p.ParameterName = 'MustBeStocked') then MustBeStocked := p.P_String; raise notice ' MustBeStocked=%', MustBeStocked; else raise notice '*** Unknown Parameter=%', p.ParameterName; end if; end loop; raise notice ' Record_ID=%', Record_ID; /** * Get Info + Lock */ ResultStr := 'ReadingRecord'; select IsCreated, Processed, AD_Client_ID, AD_Org_ID, IsCostCalculated, IsReversedCostCalculated, isreversed into strict IsCreated1, Processed1, Client_ID, Org_ID, IsCostCalculated1, IsReversedCostCalculated1, IsReversed1 from M_Production where M_Production_ID = Record_ID for update; /** * No Action IF (Processed <> 'N') THEN MESSAGE := '@AlreadyPosted@'; GOTO FINISH_PROCESS; END IF;*/ /************************************************************************** * Create Lines */ if (IsCreated1 <> 'Y') then ValidPP := 'N'; for pp in CUR_PP loop ValidPP := 'Y'; delete from M_ProductionLine where M_ProductionPlan_ID = pp.M_ProductionPlan_ID and coalesce(M_Product_ID, 0) > 0; ResultStr := 'CreatingLine BOM'; Line := 10; NextNo := AD_Sequence_Next('M_ProductionLine', 1000001); raise notice 'M_ProductionPlan_ID: %', pp.M_ProductionPlan_ID; raise notice 'M_ProductionLine_ID: %', NextNo; insert into M_ProductionLine ( M_ProductionLine_ID, M_ProductionPlan_ID, Line, AD_Client_ID, AD_Org_ID, IsActive, Created, CreatedBy, Updated, UpdatedBy, M_Product_ID, MovementQty, M_Locator_ID, Description, PlannedQty, C_UOM_ID, M_Production_ID, M_Warehouse_ID, M_AttributeSetInstance_ID, MaterialType ) values ( NextNo, pp.M_ProductionPlan_ID, Line, pp.AD_Client_ID, pp.AD_Org_ID, 'Y', CURRENT_DATE, 0, CURRENT_DATE, 0, pp.M_Product_ID, pp.ProductionQty, pp.M_Locator_ID, pp.Description, pp.ProductionQty, pp.C_UOM_ID, pp.M_Production_ID, pp.M_Warehouse_ID, pp.M_AttributeSetInstance_ID, 'F' ); /****change by amit****/ countRecord := 0; select COUNT(*) into countRecord from AD_MODULEINFO where IsActive = 'Y' and PREFIX = 'VAMFG_'; if (countRecord > 0) then sql_query := 'SELECT COUNT(*) FROM M_Product p, M_BOM b, M_BOMProduct bp WHERE p.M_Product_ID = ' || pp.M_Product_ID || ' AND p.IsBOM = ''' || 'Y''' || ' AND p.IsVerified = ''' || 'Y''' || ' AND b.M_Product_ID = p.M_Product_ID AND bp.M_BOM_ID = b.M_BOM_ID AND bp.IsActive = ''' || 'Y''' || ' AND b.BOMType = ''' || 'A''' || ' AND b.BOMUse = ''' || 'A''' || ' AND b.IsActive = ''' || 'Y'''; else sql_query := 'SELECT COUNT(*) FROM M_Product_BOM pb WHERE pb.M_Product_ID=' || pp.M_Product_ID; end if; execute sql_query into strict componentCount; if (componentCount = 0) then ValidPP := 'N'; select 'Component not Found for this produced product : ' || Name into strict MESSAGE from M_Product where M_Product_ID = pp.M_Product_ID; /* --GOTO FINISH_PROCESS;*/ isGotoExit := 't'; raise exception ''; end if; /* --IF isGotoExit = 'f' THEN -- goto exit section 1*/ if (countRecord > 0) then for bom in CUR_BOM(pp.M_Product_ID, pp.M_BOM_ID) loop ResultStr := 'CreatingLine Products'; Line := Line + 10; NextNo := AD_Sequence_Next('M_ProductionLine', 1000001); /*GETPRODUCTCOSTS ( bom.M_ProductBOM_ID, pp.AD_Client_ID, pp.AD_Org_ID , 0 , Price ) ;*/ insert into M_ProductionLine ( M_ProductionLine_ID, M_ProductionPlan_ID, Line, AD_Client_ID, AD_Org_ID, IsActive, Created, CreatedBy, Updated, UpdatedBy, M_Product_ID, MovementQty, M_Locator_ID, PlannedQty, C_UOM_ID, M_Production_ID, M_Warehouse_ID, Amt, M_AttributeSetInstance_ID, MaterialType, VAS_IsProportionateCost) values ( NextNo, pp.M_ProductionPlan_ID, Line, pp.AD_Client_ID, pp.AD_Org_ID, 'Y', CURRENT_DATE, 0, CURRENT_DATE, 0, bom.M_ProductBOM_ID, - pp.ProductionQty * bom.BOMQty, pp.M_Locator_ID, - pp.ProductionQty * bom.BOMQty, bom.C_UOM_ID, pp.M_Production_ID, pp.M_Warehouse_ID, Price, bom.CompASI, 'C', bom.VAS_IsProportionateCost); end loop; else for bom in ( select pb.*, ( select pp1.C_UOM_ID from M_Product pp1 where pp1.M_Product_ID = pb.M_ProductBOM_ID ) as ProdComp_UOM_ID, ( select pp1.Name from M_Product pp1 where pp1.M_Product_ID = pb.M_ProductBOM_ID ) as ProdComp_Name from M_Product_BOM pb where pb.M_Product_ID = pp.M_Product_ID order by Line ) loop ResultStr := 'CreatingLine Products'; Line := Line + 10; NextNo := AD_Sequence_Next('M_ProductionLine', 1000001); /*GETPRODUCTCOSTS ( bom.M_ProductBOM_ID, pp.AD_Client_ID,pp.AD_Org_ID , 0 , Price ) ;*/ insert into M_ProductionLine ( M_ProductionLine_ID, M_ProductionPlan_ID, Line, AD_Client_ID, AD_Org_ID, IsActive, Created, CreatedBy, Updated, UpdatedBy, M_Product_ID, MovementQty, M_Locator_ID, PlannedQty, C_UOM_ID, M_Production_ID, M_Warehouse_ID, Amt, M_AttributeSetInstance_ID, MaterialType ) values ( NextNo, pp.M_ProductionPlan_ID, Line, pp.AD_Client_ID, pp.AD_Org_ID, 'Y', CURRENT_DATE, 0, CURRENT_DATE, 0, bom.M_ProductBOM_ID, - pp.ProductionQty * bom.BOMQty, pp.M_Locator_ID, - pp.ProductionQty * bom.BOMQty, bom.ProdComp_UOM_ID, pp.M_Production_ID, pp.M_Warehouse_ID, Price, bom.M_AttributeSetInstance_ID, 'C' ); end loop; end if; /* added Overhead VA019 - 24-7-2017 */ countRecord := 0; select COUNT(*) into countRecord from AD_MODULEINFO where IsActive = 'Y' and PREFIX = 'VA019_'; if (countRecord > 0) then sql_query := 'SELECT oh.C_CHARGE_ID , CASE WHEN p.c_uom_id = p.VA019_YieldUOM THEN oh.VA019_AMOUNT WHEN (SELECT COUNT(*) FROM C_UOM_Conversion WHERE isactive = ''Y'' AND C_UOM_ID = p.VA019_YieldUOM AND C_UOM_To_ID = p.c_uom_id AND m_product_id = oh.m_product_id AND ad_client_id = oh.AD_client_id) > 0 THEN oh.VA019_AMOUNT * (SELECT DivideRate FROM C_UOM_Conversion WHERE isactive = ''Y'' AND C_UOM_ID = p.VA019_YieldUOM AND C_UOM_To_ID = p.c_uom_id AND m_product_id = oh.m_product_id AND ad_client_id = oh.AD_client_id ) WHEN (SELECT COUNT(*) FROM C_UOM_Conversion WHERE isactive = ''Y'' AND C_UOM_ID = p.VA019_YieldUOM AND C_UOM_To_ID = p.c_uom_id AND ad_client_id = oh.AD_client_id) > 0 THEN oh.VA019_AMOUNT * (SELECT DivideRate FROM C_UOM_Conversion WHERE isactive = ''Y'' AND C_UOM_ID = p.VA019_YieldUOM AND C_UOM_To_ID = p.c_uom_id AND ad_client_id = oh.AD_client_id ) WHEN (SELECT COUNT(*) FROM C_UOM_Conversion WHERE isactive = ''Y'' AND C_UOM_ID = p.VA019_YieldUOM AND C_UOM_To_ID = p.c_uom_id AND ad_client_id = 0) > 0 THEN oh.VA019_AMOUNT * (SELECT DivideRate FROM C_UOM_Conversion WHERE isactive = ''Y'' AND C_UOM_ID = p.VA019_YieldUOM AND C_UOM_To_ID = p.c_uom_id AND ad_client_id = 0 ) END AS VA019_AMOUNT FROM VA019_OverHead oh INNER JOIN m_product p ON p.m_product_id = oh.m_product_id WHERE oh.M_Product_ID=:PPr AND oh.IsActive = ''Y'' ORDER BY VA019_OverHead_ID' ; open cur_overhead for execute sql_query using pp.M_Product_ID; loop fetch cur_overhead into v_C_Charge_ID, v_OverheadAmount; exit when not found; /* apply on cur_overhead */ ResultStr := 'CreatingLine Overhead'; Line := Line + 10; NextNo := AD_Sequence_Next('M_ProductionLine', 1000001); insert into M_ProductionLine ( M_ProductionLine_ID, M_ProductionPlan_ID, Line, AD_Client_ID, AD_Org_ID, IsActive, Created, CreatedBy, Updated, UpdatedBy, M_Product_ID, MovementQty, M_Locator_ID, PlannedQty, C_UOM_ID, M_Production_ID, M_Warehouse_ID, C_Charge_ID, Amt ) values ( NextNo, pp.M_ProductionPlan_ID, Line, pp.AD_Client_ID, pp.AD_Org_ID, 'Y', CURRENT_DATE, 0, CURRENT_DATE, 0, null, 1, null, 1, null, pp.M_Production_ID, null, v_C_Charge_ID, v_OverheadAmount ); end loop; close cur_overhead; end if; end loop; if isGotoExit = 'f' then if (ValidPP = 'Y') then update M_Production set IsCreated = 'Y' where M_Production_ID = Record_ID; else if (IsCreated1 <> 'Y') then MESSAGE := '@BOMNotVerified@'; raise NO_DATA_FOUND; end if; end if; end if; /************************************************************************** * Post Lines */ else if isGotoExit = 'f' then select ISCOSTMANDATORY into strict v_isCostMandatory from AD_Client where AD_Client_ID = Client_ID; if (IsReversed1 = 'N') then for pl in CUR_PL_Post loop if(pl.M_Product_ID > 0 and ((pl.M_Product_ID <> pl.PlanProduct_ID) or (pl.M_Product_ID = pl.PlanProduct_ID and coalesce(pl.M_AttributeSetInstance_ID, 0) <> coalesce(pl.PlanAttribute_ID, 0))) and ((pl.ProductionQty < 0 and pl.MovementQty < 0) or (pl.ProductionQty > 0 and pl.MovementQty > 0))) then MESSAGE := '@VAS_InCorectQty@' || pl.Name; isGotoExit := 't'; raise notice 'Incorrect Quantity found for Component %', pl.Name; raise exception ''; end if; for att in cur_attr(pl.M_Product_ID) loop if(coalesce(pl.M_AttributeSetInstance_ID , 0) = 0 and att.atrcnt > 0) then message := pl.name || ': ' || '@M_AttributeSet_ID@' || '@IsMandatory@'; isGotoExit := 't'; raise notice 'Attribute Set Instance mandatory for: %', pl.name; raise exception ''; end if; end loop; end loop; end if; for pl in CUR_PL_Post loop raise notice 'start checkfuturedaterecord %', Record_ID; countfutRec := checkfuturedaterecord(pl.MovementDate::date, 'M_PRODUCTION', Record_ID::integer); raise notice 'checkfuturedaterecord1 % %', countfutRec, isGotoExit; if(countfutRec > 0) then MESSAGE := '@AlreadyFound@'; isGotoExit := 't'; raise notice 'Exit %', isGotoExit; raise exception ''; end if; if ( pl.MovementQty < 0 and MustBeStocked <> 'N' and bomQtyOnHandForProduction( pl.M_Product_ID, coalesce(pl.M_AttributeSetInstance_ID, 0), null, pl.M_Locator_ID, pl.m_attributeset_id ) + pl.MovementQty < 0 ) then select '@NotEnoughStocked@ ' || Name into strict MESSAGE from M_Product where M_Product_ID = pl.M_Product_ID; raise notice 'Not Stock Found %', pl.M_Product_ID; /*--GOTO FINISH_PROCESS;*/ isGotoExit := 't'; raise exception ''; end if; raise notice 'Stock Found %', pl.M_Product_ID; if ( pl.MovementQty < 0 and pl.IsDisallowNegativeInv = 'Y' and bomQtyOnHandForProduction( pl.M_Product_ID, coalesce(pl.M_AttributeSetInstance_ID, 0), null, pl.M_Locator_ID, pl.m_attributeset_id ) + pl.MovementQty < 0 ) then MESSAGE := '@NegativeInventoryDisallowed@ '; /*  --GOTO FINISH_PROCESS;*/ isGotoExit := 't'; raise exception ''; end if; raise notice 'Not found Negative Inventory %', pl.M_Product_ID; end loop; end if; /*****Update Cost on Production line if not calcualted**/ if (IsReversed1 <> 'Y') and (isGotoExit = 'f') then perform UpdateProductionLineWithCost(Record_ID); raise notice 'UpdateProductionLineWithCost %', Record_ID; end if; /**end**/ if isGotoExit = 'f' then for pl in CUR_PL_Post loop countRecord := 0; lockCount := 0; select COUNT(*) into countRecord from AD_MODULEINFO where IsActive = 'Y' and PREFIX = 'VAMFG_'; if (countRecord > 0) then sql_query := 'SELECT COUNT(1) FROM VAMFG_M_CycleCount l WHERE l.M_Product_ID = ' || pl.M_Product_ID || ' AND l.M_Locator_ID = ' || pl.M_Locator_ID || ' AND l.VAMFG_IsLocked =''' || 'Y'''; raise notice 'query %', sql_query; execute sql_query into strict lockCount; if (lockCount > 0) then select 'Product' || NAME || ' Locked for transaction ' into strict MESSAGE from M_Product where M_Product_ID = pl.M_Product_ID; /* --GOTO FINISH_PROCESS;*/ isGotoExit := 't'; raise exception ''; end if; end if; raise notice 'Processed1: %', Processed1; if (Processed1 <> 'Y') then update M_Storage set qtyonhand = qtyonhand + pl.MovementQty, Updated = CURRENT_DATE where M_Locator_ID = pl.M_Locator_ID and M_AttributeSetInstance_ID = coalesce(pl.M_AttributeSetInstance_ID, 0) and M_Product_ID = pl.M_Product_ID; get diagnostics r_count := ROW_COUNT; if (r_count = 0) then insert into M_Storage ( M_Product_ID, M_Locator_ID, M_AttributeSetInstance_ID, AD_Client_ID, AD_Org_ID, IsActive, Created, CreatedBy, Updated, UpdatedBy, qtyonhand ) values ( pl.M_Product_ID, pl.M_Locator_ID, coalesce(pl.M_AttributeSetInstance_ID, 0), pl.AD_Client_ID, pl.AD_Org_ID, 'Y', CURRENT_DATE, 0, CURRENT_DATE, 0, pl.MovementQty ); end if; raise notice 'updated Storage'; ResultStr := 'CreateTransaction'; /*get latest/last currentqty from transaction */ select distinct first_value(t.CurrentQty) over (partition by t.M_Product_ID, t.M_AttributeSetInstance_ID order by t.MovementDate desc, t.M_Transaction_ID desc) into CurrentQty1 from M_Transaction t where t.MovementDate <= pl.MovementDate and t.AD_Client_ID = pl.AD_Client_ID and t.movementtype not in ('VI', 'IR') and t.AD_Org_ID = pl.AD_Org_ID and t.M_Locator_ID = pl.M_Locator_ID and t.M_Product_ID = pl.M_Product_ID and coalesce(t.M_AttributeSetInstance_ID, 0) = coalesce(pl.M_AttributeSetInstance_ID, 0); if ( pl.IsDisallowNegativeInv = 'Y' and coalesce(CurrentQty1, 0) + pl.MovementQty < 0 ) then MESSAGE := '@disallownegativeinventories@'; /* --GOTO FINISH_PROCESS;*/ isGotoExit := 't'; raise exception ''; end if; NextNo := AD_Sequence_Next('M_Transaction', 1000001); insert into M_Transaction ( M_Transaction_ID, M_ProductionLine_ID, AD_Client_ID, AD_Org_ID, IsActive, Created, CreatedBy, Updated, UpdatedBy, MovementType, M_Locator_ID, M_Product_ID, M_AttributeSetInstance_ID, MovementDate, MovementQty, CurrentQty ) values ( NextNo, pl.M_ProductionLine_ID, pl.AD_Client_ID, pl.AD_Org_ID, 'Y', NOW() at TIME zone 'UTC', 0, NOW() at TIME zone 'UTC', 0, case when(pl.MovementQty > 0) then 'P+' else 'P-' end, pl.M_Locator_ID, pl.M_Product_ID, coalesce(pl.M_AttributeSetInstance_ID, 0), pl.MovementDate, pl.MovementQty, coalesce(CurrentQty1, 0) + pl.MovementQty ); raise notice 'inserted transaction'; /*update last created transation_id in Material Policy transation_id by shailesh update m_productionlinema set m_transaction_id = NextNo where m_productionline_id = pl.m_productionline_id and m_attributesetinstance_id = coalesce(pl.m_attributesetinstance_id, 0) and mmpolicydate = pl.movementdate; endcode */ /*get current qty of last created transaction*/ select CurrentQty into strict transCurentQty from M_Transaction where M_Transaction_ID = NextNo; isUpdated := UpdateTransaction( pl.AD_Client_ID, pl.AD_Org_ID, pl.M_Product_ID, coalesce(pl.M_AttributeSetInstance_ID, 0), pl.M_Locator_ID, pl.MovementDate, transCurentQty, pl.IsDisallowNegativeInv ); raise notice 'update transaction %' , isUpdated; if (isUpdated = 0) then MESSAGE := '@disallownegativeinventories@'; /*--GOTO FINISH_PROCESS;*/ isGotoExit := 't'; raise exception ''; end if; end if; if isGotoExit = 'f' then /******************* edit by amit for cost queue handling ************/ raise notice 'Cost Queue Handling Start.... '; CountCostNotAvialable := 1; sql_query := 'SELECT coalesce(COUNT(pl.m_productionline_ID), 0) FROM M_Production p INNER JOIN M_ProductionPlan pp on (p.M_Production_id = pp.M_Production_id) INNER JOIN m_productionline pl ON (pl.M_ProductionPlan_ID = pp.M_ProductionPlan_ID) INNER JOIN M_Product pr ON (pr.m_product_ID = pl.m_product_ID) WHERE  coalesce(pl.amt, 0) = 0 AND pl.isactive = ''Y'' AND pp.isactive = ''Y'' AND pl.MovementQty < 0  /*AND coalesce(pl.M_Product_ID, 0) <> COALESCE(pp.M_Product_ID, 0) */ AND pr.IsFOCItem = ''N'' AND p.m_production_id = ' || Record_ID ; execute sql_query into strict CountCostNotAvialable; raise notice 'CountCostNotAvialable: % %', sql_query, CountCostNotAvialable; if(IsReversed1 = 'N') then countcostnotavialableReverseAssembly := 1; select COUNT(pl.m_productionline_id) into strict countcostnotavialableReverseAssembly from m_productionline p inner join m_productionplan pp on ( pp.m_productionplan_id = p.m_productionplan_id ) inner join m_production pr on ( pr.m_production_id = pp.m_production_id ) where p.m_production_id = Record_ID and nvl(amt, 0) = 0 and p.isactive = 'Y' and pp.isactive = 'Y' and p.m_product_id > 0 and pr.isreversed = 'N' and ( ( pp.vas_isreverseassembly = 'N' ) or ( p.vas_isproportionatecost = 'N' and pp.vas_isreverseassembly = 'Y' ) ) and pp.productionqty < 0; if(countcostnotavialableReverseAssembly != 0 and v_iscostmandatory = 'Y') then message := '@costnotfound@'; isGotoExit := 't'; raise exception ''; end if; end if; if (CountCostNotAvialable = 0 and pl.movementqty != 0) then /* get Costing Level and costing method binded for product*/ select case when m_product_category.costingmethod is not null and m_product_category.costingmethod = 'C' then nvl(m_product_category.m_costelement_id, 0) when m_product_category.costingmethod is not null then ( select m_costelement_id from m_costelement where costingmethod = m_product_category.costingmethod and ad_client_id = pl.ad_client_id ) when c_acctschema.costingmethod is not null and c_acctschema.costingmethod = 'C' then nvl(c_acctschema.m_costelement_id, 0) else ( select m_costelement_id from m_costelement where costingmethod = c_acctschema.costingmethod and ad_client_id = pl.ad_client_id ) end as m_costelement_id, case when m_product_category.costinglevel is not null then m_product_category.costinglevel when c_acctschema.costinglevel is not null then c_acctschema.costinglevel end as costinglevel into v_definedcostelement_id, v_costinglevel from m_product inner join m_product_category on ( m_product_category.m_product_category_id = m_product.m_product_category_id ) inner join c_acctschema on ( c_acctschema.c_acctschema_id = ( select c_acctschema1_id from ad_clientinfo where ad_client_id = pl.ad_client_id ) ) where m_product.m_product_id = pl.m_product_id; raise notice 'Cost Element And Costing Level %,% ', v_definedcostelement_id, v_costinglevel; /* Get cost Before transaction*/ v_productapp