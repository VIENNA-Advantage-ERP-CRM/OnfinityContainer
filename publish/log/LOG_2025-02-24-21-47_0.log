ng Method aginst cost combination*/ select coalesce(m_productionline.reversaldoc_id, 0), iscostimmediate into strict reversaldoc_id, iscostimmediatly from m_productionline where m_productionline_id = p_m_productionline_id; /* When p_IsManual is 'W' means Need to calculate onlu linked Costing method*/ if ( p_ismanual = 'W' ) then v_iscostimmediate := 'Y'; else v_iscostimmediate := 'N'; end if; /*************************************************************/ for pp in v_CUR_AcctSchema loop v_AcctSchema_ID := pp.C_AcctSchema_ID; v_costDetail_ID := 0; raise notice 'Primary Accounting Schema %', v_AcctSchema_ID; /*************************Get Costing Level*****************************/ select CostingLevel into strict v_CostingLevelDetail from M_Product_Category where m_product_category_id = ( select m_product_category_id from m_product where m_product_id = p_M_Product_ID ); raise notice 'Costing Level From Product category Accounting : %', v_CostingLevelDetail; if (v_CostingLevelDetail is null) then select CostingLevel into strict v_CostingLevelDetail from C_AcctSchema where C_AcctSchema_ID = v_AcctSchema_ID; raise notice 'Costing Level From Accounting Schema : %', v_CostingLevelDetail; end if; /*Get Cost Element ID and Costing Method linked with Product*/ select case when pcat.costingmethod is not null and pcat.costingmethod = 'C' then pcat.m_costelement_id when acct.costingmethod is not null and acct.costingmethod = 'C' then acct.m_costelement_id else 0 end as m_costelement_id, case when pcat.costingmethod is not null then pcat.costingmethod else acct.costingmethod end as costingmethod into costelementidforcombination, definedcostingmethod from m_product p inner join m_product_category pcat on ( p.m_product_category_id = pcat.m_product_category_id ) inner join c_acctschema acct on ( acct.c_acctschema_id = v_AcctSchema_ID ) where m_product_id = p_m_product_id; /* When Linked Costing Element is Cost Combination, then get linked material cost Element and Method*/ if ( coste