(MAX(u.StdPrecision), 0) INTO STRICT StdPrecision1 FROM C_UOM u, M_Product p WHERE u.C_UOM_ID  =p.C_UOM_ID AND p.M_Product_ID=bom.M_ProductBOM_ID; ProductQty       := ROUND(ProductQty/bom.BOMQty, StdPrecision1); IF (ProductQty    < Quantity) THEN Quantity       := ProductQty; END IF; ELSIF (bom.IsBOM = 'Y') THEN ProductQty    := BOMQTYONHANDForProduction(bom.M_ProductBOM_ID, AttributeSetInstance_ID, myWarehouse_ID, Locator_ID); IF (ProductQty < Quantity) THEN Quantity    := ProductQty; END IF; END IF; END LOOP; IF (Quantity > 0) THEN SELECT COALESCE(MAX(u.StdPrecision), 0) INTO STRICT StdPrecision1 FROM C_UOM u, M_Product p WHERE u.C_UOM_ID  =p.C_UOM_ID AND p.M_Product_ID=Product_ID; RETURN ROUND(Quantity, StdPrecision1); END IF; RETURN 0; END; $BODY$;
