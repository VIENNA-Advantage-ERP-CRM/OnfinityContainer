 when coalesce(CurrentQty, 0) <> 0 then ROUND( ( ( CURRENTCOSTPRICE * (coalesce(CurrentQty, 0) - cd.qty) ) + price ) / coalesce(CurrentQty, 0) :: numeric , ( select costingprecision from c_currency where c_currency_id = ( select c_currency_id from C_AcctSchema where C_AcctSchema_ID = p_AcctSchema_ID ) ) ) else 0 end where ad_client_id = p_AD_Client_ID and ad_org_id = Org_ID and m_product_id = p_M_Product_ID and m_attributesetinstance_id = M_ASI_ID and coalesce(M_Warehouse_ID, 0) = v_M_Warehouse_ID and C_AcctSchema_ID = p_AcctSchema_ID and M_CostType_ID = ( select M_CostType_ID from C_AcctSchema where C_AcctSchema_ID = p_AcctSchema_ID ) and M_CostElement_ID = ce.M_CostElement_ID and ISAssetCost = 'N'; /* COMMIT;*/ raise notice 'm_cost updated for costing element is : %', ce.costingmethod; /* Weighted Average PO*/ when(ce.costingmethod = 'O') then update m_cost set CURRENTCOSTPRICE = case when coalesce(CurrentQty, 0) <> 0 then ROUND( ( ( CURRENTCOSTPRICE * (coalesce(CurrentQty, 0) - cd.qty) ) + price ) / coalesce(CurrentQty, 0) :: numeric , ( select costingprecision from c_currency where c_currency_id = ( select c_currency_id from C_AcctSchema where C_AcctSchema_ID = p_AcctSchema_ID ) ) ) else 0 end where ad_client_id = p_AD_Client_ID and ad_org_id = Org_ID and m_product_id = p_M_Product_ID and m_attributesetinstance_id = M_ASI_ID and coalesce(M_Warehouse_ID, 0) = v_M_Warehouse_ID and C_AcctSchema_ID = p_AcctSchema_ID and M_CostType_ID = ( select M_CostType_ID from C_AcctSchema where C_AcctSchema_ID = p_AcctSchema_ID ) and M_CostElement_ID = ce.M_CostElement_ID and ISAssetCost = 'N'; /* COMMIT;*/ raise notice 'm_cost updated for costing element is : %', ce.costingmethod; /*Standard Costing*/ when(ce.costingmethod = 'S' and isReversedVar = 'N') then select CURRENTCOSTPRICE into price from m_cost where ad_client_id = p_AD_Client_ID and ad_org_id = Org_ID and m_product_id = p_M_Product_ID and m_attributesetinstance_id = M_ASI_ID and coalesce(M_Warehouse_ID, 0) = v_M_Warehouse_ID and C_AcctSchema_ID = p_AcctSchema_ID and M_CostType_ID = ( select M_CostType_ID from C_AcctSchema where C_AcctSchema_ID = p_AcctSchema_ID ) and M_CostElement_ID = ce.M_CostElement_ID and ISAssetCost = 'N'; if (price = 0) then update m_cost set CURRENTCOSTPRICE = ROUND( CumulatedAmt / case when CumulatedQty = 0 then 1 else CumulatedQty end :: numeric , ( select costingprecision from c_currency where c_currency_id = ( select c_currency_id from C_AcctSchema where C_AcctSchema_ID = p_AcctSchema_ID ) ) ) where ad_client_id = p_AD_Client_ID and ad_org_id = Org_ID and m_product_id = p_M_Product_ID and m_attributesetinstance_id = M_ASI_ID and coalesce(M_Warehouse_ID, 0) = v_M_Warehouse_ID and C_AcctSchema_ID = p_AcctSchema_ID and M_CostType_ID = ( select M_CostType_ID from C_AcctSchema where C_AcctSchema_ID = p_AcctSchema_ID ) and M_CostElement_ID = ce.M_CostElement_ID and ISAssetCost = 'N'; /* COMMIT;*/ raise notice 'm_cost updated for costing element is : %', ce.costingmethod; end if; else raise notice 'No work for this Costing Method : %', ce.costingmethod; end case; /* COMMIT;*/ else raise notice 'start for reducing the component'; update m_cost set currentQty = coalesce(CurrentQty, 0) + cd.qty, CumulatedAmt = case when cd.qty < 0 and isReversedVar = 'Y' then coalesce(CumulatedAmt, 0) + price else coalesce(CumulatedAmt, 0) end, CumulatedQty = case when cd.qty < 0 and isReversedVar = 'Y' then coalesce(CumulatedQty, 0) + cd.qty else coalesce(CumulatedQty, 0) end where ad_client_id = p_AD_Client_ID and ad_org_id = Org_ID and m_product_id = p_M_Product_ID and m_attributesetinstance_id = M_ASI_ID and coalesce(M_Warehouse_ID, 0) = v_M_Warehouse_ID and C_AcctSchema_ID = p_AcctSchema_ID and M_CostType_ID = ( select M_CostType_ID from C_AcctSchema where C_AcctSchema_ID = p_AcctSchema_ID ) and M_CostElement_ID = ce.M_CostElement_ID and ISAssetCost = 'N'; /* COMMIT;*/ /*****************************************************************/ /* Weighted Average Cost*/ if ( ( ce.costingmethod = 'W' or ce.costingmethod = 'O' ) and isReversedVar = 'Y' ) then update m_cost set CURRENTCOSTPRICE = case when coalesce(CurrentQty, 0) <> 0 then ROUND( ( ( CURRENTCOSTPRICE * (coalesce(CurrentQty, 0) - cd.qty) ) + price ) / coalesce(CurrentQty, 0) :: numeric , ( select costingprecision from c_currency where c_currency_id = ( select c_currency_id from C_AcctSchema where C_AcctSchema_ID = p_AcctSchema_ID ) ) ) else 0 end where ad_client_id = p_AD_Client_ID and ad_org_id = Org_ID and m_product_id = p_M_Product_ID and m_attributesetinstance_id = M_ASI_ID and coalesce(M_Warehouse_ID, 0) = v_M_Warehouse_ID and C_AcctSchema_ID = p_AcctSchema_ID and M_CostType_ID = ( select M_CostType_ID from C_AcctSchema where C_AcctSchema_ID = p_AcctSchema_ID ) and M_CostElement_ID = ce.M_CostElement_ID and ISAssetCost = 'N'; /* COMMIT;*/ raise notice 'm_cost updated for costing element is : %', ce.costingmethod; end if; /*Av Inv OR Av PO*/ if ( isReversedVar = 'Y' and ( ce.costingmethod = 'I' or ce.costingmethod = 'A' ) ) then update m_cost set CURRENTCOSTPRICE = ROUND( CumulatedAmt / case when CumulatedQty = 0 then 1 else CumulatedQty end :: numeric , ( select costingprecision from c_currency where c_currency_id = ( select c_currency_id from C_AcctSchema where C_AcctSchema_ID = p_AcctSchema_ID ) ) ) where ad_client_id = p_AD_Client_ID and ad_org_id = Org_ID and m_product_id = p_M_Product_ID and m_attributesetinstance_id = M_ASI_ID and coalesce(M_Warehouse_ID, 0) = v_M_Warehouse_ID and C_AcctSchema_ID = p_AcctSchema_ID and M_CostType_ID = ( select M_CostType_ID from C_AcctSchema where C_AcctSchema_ID = p_AcctSchema_ID ) and M_CostElement_ID = ce.M_CostElement_ID and ISAssetCost = 'N'; /* COMMIT;*/ raise notice 'm_cost updated for costing element is : %', ce.costingmethod; end if; /**********************************/ if ( ce.costingmethod = 'F' or ce.costingmethod = 'L' ) then /* price              := GetPriceFromCostQueue( p_AD_Client_ID, Org_ID, p_M_Product_ID, M_ASI_ID, p_AcctSchema_ID, ce.M_CostElement_ID );*/ select * from getpricefromcostqueue1(p_ad_client_id, org_id, p_m_product_id, m_asi_id, p_acctschema_id, ce.m_costelement_id, v_m_warehouse_id) into price, errormessage; raise notice 'FIFO / LIFO cost :  %', price; if ( errormessage is not null ) then rollback; exit; end if; update m_cost set CURRENTCOSTPRICE = ROUND( price :: numeric , ( select costingprecision from c_currency where c_currency_id = ( select c_currency_id from C_AcctSchema where C_AcctSchema_ID = p_AcctSchema_ID ) ) ) where ad_client_id = p_AD_Client_ID and ad_org_id = Org_ID and m_product_id = p_M_Product_ID and m_attributesetinstance_id = M_ASI_ID and coalesce(M_Warehouse_ID, 0) = v_M_Warehouse_ID and C_AcctSchema_ID = p_AcctSchema_ID and M_CostType_ID = ( select M_CostType_ID from C_AcctSchema where C_AcctSchema_ID = p_AcctSchema_ID ) and M_CostElement_ID = ce.M_CostElement_ID and ISAssetCost = 'N'; /* COMMIT;*/ end if; /*****************************************************************/ end if; /*** Create Cost element Detail **/ select currentcostprice into mcost from m_cost where ad_client_id = p_AD_Client_ID and ad_org_id = Org_ID and m_product_id = p_M_Product_ID and m_attributesetinstance_id = M_ASI_ID and coalesce(M_Warehouse_ID, 0) = v_M_Warehouse_ID and C_AcctSchema_ID = p_AcctSchema_ID and M_CostType_ID = ( select M_CostType_ID from C_AcctSchema where C_AcctSchema_ID = p_AcctSchema_ID ) and M_CostElement_ID = ce.M_CostElement_ID and ISAssetCost = 'N' limit 1; raise notice 'Create Cost Element Detail : %', ce.costingmethod; perform CreateCostElementDetail( p_AD_Client_ID, p_ad_org_id, p_M_Product_ID, M_ASI_ID, p_AcctSchema_ID, ce.M_CostElement_ID, cd.m_productionline_id, ROUND((mcost * cd.qty) , 6), cd.qty, p_m_warehouse_id, v_movementdate ); raise notice 'Create Cost Element Detail success : %', ce.costingmethod; end loop; raise notice 'Create Costcombination  : %', p_M_Product_ID; perform CreateCostCombination( p_AD_Client_ID, Org_ID, p_M_Product_ID, p_m_attributesetinstance_id, p_AcctSchema_ID, cd.M_CostDetail_ID, cd.qty, cd.m_productionline_id, v_M_Warehouse_ID, v_movementdate); raise notice 'Create Costcombination success : %', p_M_Product_ID; end loop; /******************************************************/ exception when others then raise notice '%', sqlerrm; raise exception 'UpdateMCostnotfrpt: %' , sqlerrm; end; $function$;
