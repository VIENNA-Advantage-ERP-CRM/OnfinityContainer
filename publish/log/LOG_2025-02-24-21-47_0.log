ostDetail_ID, AD_Client_ID, AD_Org_ID, IsActive, Created, CreatedBy, Updated, UpdatedBy, C_AcctSchema_ID, M_Product_ID, Qty, Amt, M_AttributeSetInstance_ID, M_ProductionLine_ID, processed, M_Warehouse_ID, MovementDate) values ( NextNo, p_AD_Client_ID, p_ad_org_id, 'Y', NOW() at TIME zone 'UTC', 0, NOW() at TIME zone 'UTC', 0, p_AcctSchema_ID, p_M_Product_ID, p_Quantity, coalesce(p_CurrentCostPrice, 0) + coalesce(OverheadAmount, 0), p_m_attributesetinstance_id, p_M_ProductionLine_ID, 'Y', p_m_warehouse_id, v_MovementDate); M_CostDetail_ID := NextNo; /******************************************************/ exception when others then raise notice '%', sqlerrm; raise exception 'CreateCostDetailNotFrpt: %' , sqlerrm; end; $function$ ;
