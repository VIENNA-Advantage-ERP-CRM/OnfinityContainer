HECK_ID = PDC.VA027_POSTDATEDCHECK_ID ) LEFT OUTER JOIN c_bank cbk ON (CBA.C_BANK_ID = CBK.C_BANK_ID) LEFT OUTER JOIN ad_user usr ON (BP.SALESREP_ID = USR.AD_USER_ID) LEFT OUTER JOIN c_paymentterm pyt ON ( BP.C_PAYMENTTERM_ID = PYT.C_PAYMENTTERM_ID ) WHERE CP.C_DOCTYPE_ID = DT.C_DOCTYPE_ID /*AND CP.C_PAYMENT_ID=BSL.C_PAYMENT_ID(+)*/ AND CBA.C_CURRENCY_ID = CUR.C_CURRENCY_ID AND DT.DOCBASETYPE IN ('ARR', 'APP') AND CP.AD_ORG_ID = ORG.AD_ORG_ID AND ( CP.ISRECONCILED = REC_FLAG OR coalesce(REC_FLAG, '1') = '1' ) /*AND ((CASE WHEN BSL.C_PAYMENT_ID IS not NULL THEN 'Y' ELSE 'N' END)=REC_FLAG OR NVL(REC_FLAG,'1')='1')*/ AND CP.DOCSTATUS IN ('CO', 'CL', 'RE', 'VO') AND CP.C_BankAccount_ID = BANK_ACCT_ID AND CBA.C_BANK_ID = BANK_ID /*AND CP.AD_CLIENT_ID=SCH.AD_CLIENT_ID AND SCH.C_ACCTSCHEMA_ID=acctSchema_id*/ AND ORG.AD_ORG_ID = ORG_INFO.AD_ORG_ID ) alias30 UNION ALL SELECT BST.AD_CLIENT_ID, ORG.AD_ORG_ID, BST.NAME, 'CHRG', coalesce(BSL.DESCRIPTION, CH.NAME) DESCRIPTION, ORG.NAME ORG_NAME, BST.STATEMENTDATE, BSL.C_BPARTNER_ID, BP.VALUE BP_CODE, BP.NAME CUSTOMER_NAME, ( CASE WHEN BSL.STMTAMT >= 0 THEN BSL.STMTAMT ELSE 0 END ) DEBIT, ( CASE WHEN BSL.STMTAMT < 0 THEN ABS(BSL.STMTAMT) ELSE 0 END ) CREDIT, 0 PDC_AMT, BP.SO_CREDITLIMIT, NULL PAYMENT_TERM, NULL PDC_DATE, NULL C_ACCTSCHEMA_ID, NULL ACCT_SCHEMA, /* SCH.C_ACCTSCHEMA_ID,SCH.NAME ACCT_SCHEMA, ORG_INFO.PHONE,ORG_INFO.FAX,*/ BACCT.ACCOUNTNO, BNK.NAME BANK_NAME, BACCT.C_BankAccount_ID, BNK.C_BANK_ID, CR.ISO_CODE, 'Y' RECONCILED, NULL FROM ad_orginfo org_info, ad_org org, c_currency cr, c_charge ch, c_bankstatement bst, c_bank bnk, c_bankaccount bacct, c_bankstatementline bsl LEFT OUTER JOIN c_bpartner bp ON ( BSL.C_BPARTNER_ID = BP.C_BPARTNER_ID ) WHERE BST.AD_ORG_ID = ORG.AD_ORG_ID AND ORG.AD_ORG_ID = ORG_INFO.AD_ORG_ID AND BST.C_BANKACCOUNT_ID = BACCT.C_BANKACCOUNT_ID AND BACCT.C_CURRENCY_ID = CR.C_CURRENCY_ID AND BACCT.C_BANK_ID = BNK.C_BANK_ID AND BSL.C_CHARGE_ID = CH.C_CHARGE_ID AND 1 = 2 AND BST.C_BANKACCOUNT_ID = BANK_ACCT_ID AND BST.AD_CLIENT_ID = client_id AND ( BST.AD_ORG_ID = org_id OR coalesce(org_id, 1) = 1 ) AND BNK.C_BANK_ID = BANK_ID AND 1 = 2 AND BST.DOCSTATUS IN ('CO', 'CL') AND BST.C_BankStatement_ID = BSL.C_BankStatement_ID ) alias38 WHERE AD_CLIENT_ID = CLIENT_ID AND ( AD_ORG_ID = ORG_ID OR coalesce(ORG_ID, 1) = 1 ) AND DATEACCT <= P_DATE; RETURN V_PREV_BAL; EXCEPTION WHEN OTHERS THEN V_PREV_BAL := 0; RETURN V_PREV_BAL; END; $BODY$;
