T) * ABS(IV.GRANDTOTAL) END ),0) CREDIT, 0 PDC_AMT FROM C_INVOICE IV , C_DOCTYPE DT, C_BPARTNER BP, AD_ORG ORG, C_ACCTSCHEMA SCH WHERE IV.C_DOCTYPETARGET_ID=DT.C_DOCTYPE_ID AND IV.C_BPARTNER_ID       =BP.C_BPARTNER_ID AND BP.ISEMPLOYEE          ='N' AND IV.AD_CLIENT_ID        =SCH.AD_CLIENT_ID AND SCH.C_ACCTSCHEMA_ID    =ACCT_SCHEMA AND DT.DOCBASETYPE        IN ('ARI','ARC') AND IV.DOCSTATUS          IN ('CO','CL') AND IV.AD_ORG_ID           =ORG.AD_ORG_ID UNION ALL SELECT IV.AD_CLIENT_ID, IV.AD_ORG_ID, ORG.NAME ORG_NAME, AHDR.DATEACCT, IV.C_BPARTNER_ID, BP.VALUE BP_CODE, BP.NAME CUSTOMER_NAME , NVL(( CASE WHEN(DT.DOCBASETYPE = 'ARI' AND IV.GRANDTOTAL    < 0) OR (DT.DOCBASETYPE   = 'ARC' AND IV.GRANDTOTAL    > 0) THEN NVL(( CASE WHEN IV.C_CURRENCY_ID=VA056_GetBaseCurAcctSchema(IV.ad_client_id,SCH.C_ACCTSCHEMA_ID) THEN coalesce(ABS(ALN.WRITEOFFAMT),0)+coalesce(ABS(ALN.DISCOUNTAMT),0) WHEN IV.C_CURRENCY_ID <> VA056_GetBaseCurAcctSchema(IV.ad_client_id,SCH.C_ACCTSCHEMA_ID) THEN VA056_GetConversionRate(IV.C_CURRENCY_ID,VA056_GetBaseCurAcctSchema(IV.ad_client_id,SCH.C_ACCTSCHEMA_ID),IV.C_CONVERSIONTYPE_ID,IV.DATEACCT) * (coalesce(ABS(ALN.WRITEOFFAMT),0)+coalesce(ABS(ALN.DISCOUNTAMT),0)) END ),0) ELSE 0 END),0) DEBIT, NVL(( CASE WHEN(DT.DOCBASETYPE = 'ARI' AND IV.GRANDTOTAL    > 0) OR (DT.DOCBASETYPE   = 'ARC' AND IV.GRANDTOTAL    < 0) THEN NVL(( CASE WHEN IV.C_CURRENCY_ID=VA056_GetBaseCurAcctSchema(IV.ad_client_id,SCH.C_ACCTSCHEMA_ID) THEN coalesce(ABS(ALN.WRITEOFFAMT),0)+coalesce(ABS(ALN.DISCOUNTAMT),0) WHEN IV.C_CURRENCY_ID <> VA056_GetBaseCurAcctSchema(IV.ad_client_id,SCH.C_ACCTSCHEMA_ID) THEN VA056_GetConversionRate(IV.C_CURRENCY_ID,VA056_GetBaseCurAcctSchema(IV.ad_client_id,SCH.C_ACCTSCHEMA_ID),IV.C_CONVERSIONTYPE_ID,IV.DATEACCT) * (coalesce(ABS(ALN.WRITEOFFAMT),0)+coalesce(ABS(ALN.DISCOUNTAMT),0)) END ),0) ELSE 0 END),0) CREDIT, 0 PDC_AMT FROM c_acctschema sch, ad_orginfo org_info, ad_org org, ad_org ig, c_currency fc, c_doctype dt, c_currency cur, ad_client cl, c_