mer, ad_client_id, issotrx, orgname, ad_org_id, c_bpartner_id, c_bp_group_id, c_invoice_id, c_conversiontype_id, c_payment_id, c_currency_id, bpcode, bp, bpgroup, dateacct, documentno, invoiceamt, paidamt, c_doctype_id, doctype, total, currency, docbasetype FROM ( WITH allocation AS ( SELECT c_allocationline.c_invoicepayschedule_id, MAX(c_allocationhdr.dateacct) AS datetrx FROM c_allocationline INNER JOIN c_allocationhdr ON c_allocationline.c_allocationhdr_id = c_allocationhdr.c_allocationhdr_id WHERE c_allocationhdr.docstatus IN ( 'CO', 'CL' ) GROUP BY c_allocationline.c_invoicepayschedule_id ) SELECT isvendor, iscustomer, ad_client_id, issotrx, orgname, ad_org_id, c_bpartner_id, c_bp_group_id, c_invoice_id, c_conversiontype_id, c_payment_id, c_currency_id, bpcode, bp, bpgroup, dateacct, documentno, invoiceamt, paidamt, c_doctype_id, doctype, total, currency, docbasetype FROM ( SELECT c_bpartner.isvendor, c_bpartner.iscustomer, c_invoice.ad_client_id, c_invoice.issotrx, ad_org.name AS orgname, c_invoice.ad_org_id, c_invoice.c_bpartner_id, c_invoice.c_invoice_id, c_invoice.c_conversiontype_id, NULL AS c_payment_id, c_invoice.c_currency_id, c_bpartner.c_bp_group_id, c_bpartner.value AS bpcode, c_bpartner.name AS bp, c_bp_group.name AS bpgroup, c_invoice.dateacct AS dateacct, c_invoice.docstatus, c_invoice.documentno, ( CASE WHEN ( c_invoice.c_currency_id != c_acctschema.c_currency_id ) THEN currencyconvert(c_invoice.grandtotal, c_invoice.c_currency_id, c_acctschema.c_currency_id, c_invoice.dateacct , c_invoice.c_conversiontype_id, c_invoice.ad_client_id, c_invoice.ad_org_id) ELSE c_invoice.grandtotal END ) * ( CASE WHEN c_doctype.docbasetype IN ( 'APC', 'ARC' ) THEN - 1 ELSE 1 END ) AS invoiceamt, nvl(( SELECT SUM(c_invoicepayschedule.va009_paidamntinvce) FROM c_invoicepayschedule LEFT JOIN allocation ON c_invoicepayschedule.c_invoicepayschedule_id = allocation.c_invoicepayschedule_id WHERE ( CASE WHEN(allocation.datetrx <= p_asondate) OR(allocation.datetrx IS NULL A