A_ID), INV.C_CONVERSIONTYPE_ID, INV.DATEACCT) * (ABS(AL.AMOUNT) + ABS(coalesce(AL.WriteOffAmt, 0)) + ABS(coalesce(AL.DiscountAmt, 0))) END ), 0)) FROM C_ALLOCATIONLINE AL ,C_ALLOCATIONHDR HDR WHERE AL.C_ALLOCATIONHDR_ID = HDR.C_ALLOCATIONHDR_ID AND HDR.DOCSTATUS IN ( 'CO' ,'CL' ) AND AL.C_INVOICE_ID = INV.C_INVOICE_ID AND HDR.DATEACCT <= date1 ), 0) ) END ), 0) /*- COALESCE((CASE WHEN IPV.C_CURRENCY_ID=VA056_GetBaseCurAcctSchema(INV.AD_CLIENT_ID,SCH.C_ACCTSCHEMA_ID)  then COALESCE(IPV.VA009_PaidAmntInvce,0) WHEN IPV.C_CURRENCY_ID <> VA056_GetBaseCurAcctSchema(INV.AD_CLIENT_ID,SCH.C_ACCTSCHEMA_ID) THEN VA056_GetConversionRate(IPV.C_CURRENCY_ID,VA056_GetBaseCurAcctSchema(INV.AD_CLIENT_ID,SCH.C_ACCTSCHEMA_ID),COALESCE(INV.C_CONVERSIONTYPE_ID, VA056_GetDefaultConversion()),INV.DATEACCT) * COALESCE(IPV.VA009_PaidAmntInvce,0)  END ),0)*/ ) END ) DUEAMT ,CASE WHEN date_trunc('day', INV.DATEACCT) = date_trunc('day', date2) THEN INV.GRANDTOTAL END CURRENT_DUEAMT ,/* FN_GET_DUEAMT_CUSTOMER(date1, INV.C_BPARTNER_ID, INV.AD_ORG_ID)*/ 0 PREVIOUS_DUE_AMT ,'cCurrent Due' BUCKET_DETAILS ,CA.C_ACTIVITY_ID ,CA.NAME ACTIVITY ,SCH.C_ACCTSCHEMA_ID ,SCH.NAME ACCT_NAME ,CTY.C_COUNTRY_ID ,CTY.NAME COUNTRY FROM c_acctschema sch ,ad_orginfo org_info ,/* (SELECT DISTINCT AD_CLIENT_ID,AD_ORG_ID,C_INVOICE_ID,C_BPARTNER_ID,C_CURRENCY_ID,DUEDATE FROM C_InvoicePaySchedule WHERE VA009_ISPAID='N') IPV, C_InvoicePaySchedule IPV,*/ ad_org org ,c_currency cur ,ad_client cl ,c_doctype cdt ,c_bpartner bp LEFT OUTER JOIN c_bp_group bpg ON (BP.C_BP_GROUP_ID = BPG.C_BP_GROUP_ID) ,c_invoice inv LEFT OUTER JOIN c_bpartner_location cblt ON (INV.C_BPARTNER_LOCATION_ID = CBLT.C_BPARTNER_LOCATION_ID) LEFT OUTER JOIN c_activity ca ON (INV.c_activity_id = CA.c_activity_id) LEFT OUTER JOIN c_location loc ON (CBLT.C_LOCATION_ID = LOC.C_LOCATION_ID) LEFT OUTER JOIN c_country cty ON (LOC.C_COUNTRY_ID = CTY.C_COUNTRY_ID) WHERE BP.C_BPARTNER_ID = INV.C_BPARTNER_ID AND INV.AD_CLIENT_ID = CL.AD_CLIENT_ID AND ( INV.C_BPARTNER_ID = BPARTNER_ID OR coalesce(BPARTNER_ID, 1) = 1 ) AND ( CTY.C_COUNTRY_ID = COUNTRY_ID OR coalesce(COUNTRY_ID, 1) = 1 ) AND ( INV.c_activity_id = activity_id OR coalesce(activity_id, 1) = 1 ) AND SCH.C_ACCTSCHEMA_ID = acctsch_id AND INV.AD_CLIENT_ID = SCH.AD_CLIENT_ID AND INV.DOCSTATUS IN ( 'CO' ,'CL' ) AND BP.ISEMPLOYEE = 'N' /*  AND IPV.C_INVOICE_ID = INV.C_INVOICE_ID*/ AND INV.C_DOCTYPETARGET_ID = CDT.C_DOCTYPE_ID AND CDT.DOCBASETYPE IN ( 'ARI' ,'ARC' ) /*   AND INV.ISPAID='N' AND IPV.VA009_ISPAID='N'*/ AND INV.AD_ORG_ID = ORG.AD_ORG_ID AND INV.AD_CLIENT_ID = CLIENT_ID AND INV.AD_ORG_ID = ORG_INFO.AD_ORG_ID AND ( INV.AD_ORG_ID = ORG_ID OR coalesce(ORG_ID, 1) = 1 ) AND sch.c_currency_id = CUR.C_CURRENCY_ID AND ( BP.C_BP_GROUP_ID = BP_GROUP_ID OR coalesce(BP_GROUP_ID, 0) = 0 ) AND date_trunc('day', INV.DATEACCT) <= date1 AND extract(epoch from (date_trunc('day', date1) - date_trunc('day', INV.DATEACCT))/(3600*24))::integer < 0 AND ( extract(epoch from (date_trunc('day', date1) - date_trunc('day', INV.DATEACCT))/(3600*24))::integer <= ( SELECT MAX(A.TODAY) FROM VARPT_AgingDetails A ,VARPT_AgingBUCKET B WHERE A.VARPT_AGINGBUCKET_ID = B.VARPT_AGINGBUCKET_ID AND A.VARPT_AGINGBUCKET_ID = BUCKET_ID AND B.AD_CLIENT_ID = client_id ) ) ) alias153 GROUP BY AD_ORG_ID ,C_BPARTNER_ID ,CUSTOMER ,ORG_NAME ,PHONE ,ISO_CODE ,C_CURRENCY_ID ,C_BP_GROUP_ID ,BPGROUP_NAME ,DATEINVOICED ,BUCKET_DETAILS ,C_ACTIVITY_ID ,ACTIVITY ,C_ACCTSCHEMA_ID ,ACCT_NAME ,C_COUNTRY_ID ,COUNTRY ,DOCUMENTNO ,C_INVOICE_ID ) alias154 WHERE DUEAMT <> 0 LIMIT fetch_size LOOP INSERT INTO TEMP_CUSTOMER_AGING_DETAIL_TMP_6 ( AD_PInstance_ID ,ad_org_id ,ad_client_id ,C_ACCTSCHEMA_ID ,ACCT_NAME ,DOCUMENTNO ,c_bpartner_id ,C_COUNTRY_ID ,COUNTRY ,ISPDC ,c_bp_GROUP_id ,C_CURRENCY_ID ,ISO_CODE ,DATEINVOICED ,VARPT_AGINGBUCKET_ID ,BUCKET_NAME ,CUSTOMER ,BPGROUP_NAME ,org_name ,org_addr ,org_phone ,DUEAMT ,CURRENT_DUEAMT ,PREVIOUS_DUE_AMT ,OPENAMT ,PAIDAMT ,BUCKET_DETAILS ,tenant_name ,tenant_desc ,DATEacct_start ,DATE