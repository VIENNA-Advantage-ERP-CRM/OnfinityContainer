saction.m_locator_id, m_transaction.m_product_id, m_transaction.m_attributesetinstance_id, m_transaction.movementdate, m_transaction.currentqty, row_number() over(partition by m_transaction.ad_client_id, m_locator.ad_org_id, m_locator.m_warehouse_id, m_transaction.m_locator_id, m_transaction.m_product_id, m_transaction.m_attributesetinstance_id order by m_transaction.movementdate desc, m_transaction.m_transaction_id desc ) as rn from m_transaction inner join m_locator on m_transaction.m_locator_id = m_locator.m_locator_id inner join M_product on m_transaction.M_product_id = M_product.M_product_ID where m_transaction.movementdate <= p_date and m_locator.ad_org_id = coalesce(v_ad_org_id, m_locator.ad_org_id) /*and m_locator.m_warehouse_id = coalesce(v_warehouse_id, m_locator.m_warehouse_id) and m_transaction.m_locator_id = coalesce(v_locator_id, m_transaction.m_locator_id) and m_transaction.m_product_id = coalesce(v_product_id, m_transaction.m_product_id) and M_product.m_product_category_id = coalesce(v_productCategory_id, M_product.m_product_category_id)*/ ) select p_ad_pinstance_id as ad_pinstance_id, currentstock.ad_client_id, currentstock.ad_org_id, currentstock.m_warehouse_id, currentstock.m_locator_id, currentstock.m_product_id, currentstock.m_attributesetinstance_id, currentstock.movementdate, currentstock.currentqty, currentstock.rn, ad_org.name as org, m_warehouse.name as warehouse, m_locator.value as locator, m_product.name as product from currentstock inner join ad_org on currentstock.ad_org_id = ad_org.ad_org_id inner join m_warehouse on currentstock.m_warehouse_id = m_warehouse.m_warehouse_id inner join m_product on m_product.m_product_id = currentstock.m_product_id and m_product.ad_client_id = currentstock.ad_client_id inner join m_locator on currentstock.m_locator_id = m_locator.m_locator_id where currentstock.rn = 1; raise notice '3'; resultstr := 'Done'; update ad_pinstance set updated = CURRENT_TIMESTAMP, isprocessing = 'N', result = 1, errormsg = re