<div class="wsp-header" style="height: 42px">

    <div class="wsp-header-down" style="height: 100%">
        <div class="wsp-contact-header">
            <h3 id="headerContact_@ViewBag.WindowNumber" class="wsp-sale-order">@VAdvantage.Utility.Msg.GetMsg((string)ViewBag.culture, "WSP_Contacts")</h3>
        </div>

        <div class="wsp-header-down-right">
            <div class="wsp-li-close-img" style="float: right">

                <a id="btnClose_@ViewBag.WindowNumber" href="javascript:void(0)" class="vis-mainMenuIcons vis-icon-menuclose"></a>
            </div>
            <div style="width: auto; float: right">
                <ul class="wsp-up-ul-li">
                    <li id="liSetting_@ViewBag.WindowNumber" class="wsp-pretraga" ><a id="settings_@ViewBag.WindowNumber" class="anchor" href="javascript:void(0)"><span style="float: left" class="wsp-left_icon" title="@VAdvantage.Utility.Msg.GetMsg((string)ViewBag.culture, "WSP_GoogleSetting")">
    <i class="vis vis-gmail-settings"></i></span></a></li>
                    <li id="liImportContacts_@ViewBag.WindowNumber" class="wsp-pretraga" ><a id="ImportContacts_@ViewBag.WindowNumber" class="anchor" href="javascript:void(0)"><span style="float: left" class="wsp-left_icon" title="@VAdvantage.Utility.Msg.GetMsg((string)ViewBag.culture, "ImportContacts")">
    @*<img src="~/Areas/WSP/Images/imaport-contacts.png">*@
    <i class="vis vis-gmail-contacts-import"></i></span></li>
                    <li id="liaddBPartner_@ViewBag.WindowNumber" class="wsp-pretraga" ><a id="HeaderaddBPartner_@ViewBag.WindowNumber" class="anchor" href="javascript:void(0)"><span style="float: left" class="wsp-left_icon" title="@VAdvantage.Utility.Msg.GetMsg((string)ViewBag.culture, "WSP_AddBusinessPartner")">
                        <i class="vis vis-addbp"></i></span></a></li>
                    <li id="liaddBPartner_1" class="wsp-pretraga" >
                        <div style="border-right: rgba(var(--v-c-on-primary), 1); border-width: 2px; height: 25px;">
                        </div>
                    </li>
                    <li id="liContactType_@ViewBag.WindowNumber" class="wsp-min-width wsp-dropdwn">
                        <i class="fa fa-filter"></i><a id="contactType" href="javascript:void(0)">@VAdvantage.Utility.Msg.GetMsg((string)ViewBag.culture, "WSP_ContactType")</a>
                        <ul id="ulContactType_@ViewBag.WindowNumber" class="wsp-inner_ul">
                            <li></li>
                            <li id="lstCustomer_@ViewBag.WindowNumber" role="presentation"><a class="anchor" role="menuitem" tabindex="-1" style="opacity: 0.8;" href="javascript:void(0)">@VAdvantage.Utility.Msg.GetMsg((string)ViewBag.culture, "Customer")</a></li>
                            <li id="lstVendor_@ViewBag.WindowNumber" role="presentation"><a class="anchor" role="menuitem" tabindex="-1" style="opacity: 0.8;" href="javascript:void(0)">@VAdvantage.Utility.Msg.GetMsg((string)ViewBag.culture, "Vendor")</a></li>
                            <li id="lstEmployee_@ViewBag.WindowNumber" role="presentation"><a class="anchor" role="menuitem" tabindex="-1" style="opacity: 0.8;" href="javascript:void(0)">@VAdvantage.Utility.Msg.GetMsg((string)ViewBag.culture, "Employee")</a></li>
                            <li id="lstProspect_@ViewBag.WindowNumber" role="presentation"><a class="anchor" role="menuitem" tabindex="-1" style="opacity: 0.8;" href="javascript:void(0)">@VAdvantage.Utility.Msg.GetMsg((string)ViewBag.culture, "Prospect")</a></li>
                            <li id="lstAll_@ViewBag.WindowNumber" role="presentation"><a class="anchor" role="menuitem" tabindex="-1" style="opacity: 0.8;" href="javascript:void(0)">@VAdvantage.Utility.Msg.GetMsg((string)ViewBag.culture, "All")</a></li>
                        </ul>
                    </li>

                    <li class="wsp-pretraga wsp-cnt-topsearchwrp" >
                        <div>
                            <input id="txtSearch_@ViewBag.WindowNumber" class="wsp-contact-search-input" type="text">
                            <button id="btnSearch_@ViewBag.WindowNumber" class="wsp-sear">
                                <i class="vis vis-search"></i>
                            </button>
                        </div>
                    </li>
                    <li id="liadvanceSearch_@ViewBag.WindowNumber" class="wsp-pretraga" ><a id="advanceSearch_@ViewBag.WindowNumber" class="anchor" href="javascript:void(0)"><span style="float: left;" class="wsp-left_icon" title="@VAdvantage.Utility.Msg.GetMsg((string)ViewBag.culture, "AdvanceSearch")">
                       <i class="vis vis-find"></i></span></a></li>
                </ul>
            </div>

        </div>

    </div>
</div>






