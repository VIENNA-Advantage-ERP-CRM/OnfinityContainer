    <div id="divBirthday_@ViewBag.WindowNumber" class="wsp-birthday_container">

        @if (@Model[0].Birthday.ToString() == "")
        {
            return;
        }


        <div class="wsp-birthdat_text">
            @*  <div class="wsp-birth_pic">
                    <img width="30px" height="30px"  src=@Url.Content("~/" + @Model[0].Image) >
                </div>*@
            @if (@Model[0].Birthday == @DateTime.Now.Date.ToString())
            {
                <p>@VAdvantage.Utility.Msg.GetMsg((string)ViewBag.culture, "WSP_Today")  @VAdvantage.Utility.Msg.GetMsg((string)ViewBag.culture, "WSP_is") <span class="wsp-birthday_text_highlight">@Model[0].FirstName </span> @VAdvantage.Utility.Msg.GetMsg((string)ViewBag.culture, "WSP_Birthday")</p>
            }
            <p>@Model[0].FirstName  @VAdvantage.Utility.Msg.GetMsg((string)ViewBag.culture, "WSP_Birthday") @VAdvantage.Utility.Msg.GetMsg((string)ViewBag.culture, "WSP_on") <span class="wsp-birthday_text_highlight">@String.Format("{0:dd-MMM-yy}", Model[0].Birthday)</span></p>
        </div>
    </div>
</div>


</div>
<div class="wsp-clear-both"></div>

