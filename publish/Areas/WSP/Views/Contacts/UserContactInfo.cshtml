<div class="wsp-view_left_part">
    <input type="hidden" value=@Model[0].UserID id="userID_@ViewBag.WindowNumber" />
    @{bool isTeamExist = false;}
    @{bool isContactDetails = false;}
    @{bool isRole = false;}


    @if (@Model[0].FirstName.Length > 15)
    {
        <p id="hduserName_@ViewBag.WindowNumber">@Model[0].FirstName</p>
        <p id="greeting_@ViewBag.WindowNumber" class="wsp-view_profile_name">@Model[0].Greeting</p>
        <p id="userName_@ViewBag.WindowNumber" title="" class="wsp-view_profile_name">@Model[0].FirstName.Substring(0, 15)<a id="dotImg_@ViewBag.WindowNumber" href="javascript:void(0)">...</a>  </p>
    }
    else
    {
        <p id="hduserName_@ViewBag.WindowNumber"></p>
        <p id="greeting_@ViewBag.WindowNumber" class="wsp-view_profile_name">@Model[0].Greeting</p>
        <p id="userName_@ViewBag.WindowNumber" class="wsp-view_profile_name">@Model[0].FirstName</p> <a id="dotImg_@ViewBag.WindowNumber" href="javascript:void(0)"></a>
    }
    <div id="popUpDiv_@ViewBag.WindowNumber"></div>
    @*<p class="wsp-view_profile_possession">@Model[0].Role</p>*@
    @*<input type="hidden" value=@Model[0].BPartnerID id="BPID_@ViewBag.WindowNumber" />
        <input type="hidden" value=@Model[0].BPGroupID id="BPGroupID_@ViewBag.WindowNumber" />*@

    <input type="hidden" value="0" id="BPID_@ViewBag.WindowNumber" />
    <input type="hidden" value="0" id="BPGroupID_@ViewBag.WindowNumber" />
    <input type="hidden" value=@Model[0].TableID id="userTableID_@ViewBag.WindowNumber" />
    @if (@Model[0].CompanyName.Length > 25)
    {
        <p id="companyName_@ViewBag.WindowNumber" class="wsp-view_profile_possession" style="word-break: break-all;">@Model[0].CompanyName</p>
        <p class="wsp-view_profile_possession" style="border-bottom: 1px solid #DFDFDF; padding-bottom: 20px;" id="pContactTypeCategory_@ViewBag.WindowNumber"></p>
    }
    else
    {
        <p id="companyName_@ViewBag.WindowNumber" class="wsp-view_profile_possession">@Model[0].CompanyName</p>
        <p class="wsp-view_profile_possession" style="border-bottom: 1px solid #DFDFDF; padding-bottom: 20px;" id="pContactTypeCategory_@ViewBag.WindowNumber"></p>
    }

    <div class="wsp-profile_big_img_mobile">

        <span id="editMobileImage_@ViewBag.WindowNumber" class="mobilespan" style="width:24px;float:right;">
            <input type="file" id="wsp-fileinput_@ViewBag.WindowNumber" class="wsp-file-input" value="Add Pic">
            <img src="~/Areas/WSP/Images/Edit-icon.png" style="z-index: 100; position: absolute;">
        </span>
        @if (@Model[0].Image.Contains("defaultUser"))
        {
            <img id="mobileImg_@ViewBag.WindowNumber" width="100%" alt="Image is not available" src=@Url.Content("~/" + @Model[0].Image)>
        }
        else
        {
            <img id="mobileImg_@ViewBag.WindowNumber" width="100%" alt="Image is not available" src=@Model[0].Image>
        }


    </div>

    <div id="divTeam_@ViewBag.WindowNumber" class="wsp-view_team">
        <p>@VAdvantage.Utility.Msg.GetMsg((string)ViewBag.culture, "Teams")</p>
        @foreach (var person in Model)
        {
            if (@person.Team != string.Empty && @person.Team != null)
            {
                isTeamExist = true;
                <p id="team_@ViewBag.WindowNumber" style="word-break: break-all">@person.Team</p>
            }
        }
        @if (!isTeamExist)
        {
            <p id="teamNotFound_@ViewBag.WindowNumber" style="word-break: break-all; font-style: italic;">@VAdvantage.Utility.Msg.GetMsg((string)ViewBag.culture, "NotFound")</p>
        }

    </div>

    <div id="divContactDetails_@ViewBag.WindowNumber" class="wsp-view_team">
        <p style="word-break: break-all;">@VAdvantage.Utility.Msg.GetMsg((string)ViewBag.culture, "ContactDetails")<img id="showAddressOnGoogleMap_@ViewBag.WindowNumber" src="/ViennaAdvantageWeb1/Areas/VIS/Images/base/ToLink20.png"></p>

        @foreach (var person in Model)
        {
            if (@person.FirstName != "")
            {
                continue;
            }
            if (@person.Address != string.Empty && @person.Address != null)
            {
                isContactDetails = true;
                <p id="address_@ViewBag.WindowNumber" style="word-break: break-all">@person.Address</p>
            }


        }

        @{string countryName = string.Empty;}
        @if (@Model[0].CountryName != string.Empty && @Model[0].CountryName != null)
        {
            isContactDetails = true;
            countryName = " (" + @Model[0].CountryName + ")";
        }
        @if (@Model[0].CountryName != string.Empty && @Model[0].CountryName != null)
        {
            isContactDetails = true;
            <p id="country_@ViewBag.WindowNumber" style="word-break: break-all">@Model[0].City @countryName</p>
        }
        @if (@Model[0].Postal != string.Empty && @Model[0].Postal != null)
        {
            isContactDetails = true;
            <p id="postal_@ViewBag.WindowNumber" style="word-break: break-all">@VAdvantage.Utility.Msg.GetMsg((string)ViewBag.culture, "ZipCode"): @Model[0].Postal </p>
        }
        @foreach (var person in Model)
        {
            if (@person.FirstName != "")
            {
                continue;
            }
            if (@person.PhoneNo != string.Empty && @person.PhoneNo != null)
            {
                isContactDetails = true;
                <p id="phone_@ViewBag.WindowNumber" style="word-break: break-all">
                    <span class="wsp-caller">
                        <img src="~/Areas/WSP/Images/caller.png">
                    </span>@person.PhoneNo
                </p>
            }
        }
        @if (@Model[0].Email != "" && @Model[0].Email != null)
        {
            isContactDetails = true;
            @*<div style="width: 100%; float: left">*@
            @*<span class="wsp-caller" style="width: 8%; margin-right: 8px">*@
            @*<span class="wsp-caller" >
                <img src="~/Areas/WSP/Images/sms.png"></span>*@
            @*<p style="word-break: break-all; width: 87%; float: left; margin-top: 5px">*@
            <p id="userEmail_@ViewBag.WindowNumber" style="word-break: break-all; display: inline-flexbox;">
                <span class="wsp-caller">
                    <img src="~/Areas/WSP/Images/sms.png">
                </span>  @Model[0].Email

            </p>
            @*</div>*@
        }
        @if (!isContactDetails)
        {
            <p id="emailNotFound_@ViewBag.WindowNumber" style="word-break: break-all; font-style: italic;">@VAdvantage.Utility.Msg.GetMsg((string)ViewBag.culture, "NotFound")</p>
        }
    </div>

    <div id="divcompanyDetails_@ViewBag.WindowNumber" class="wsp-view_team">

        <p style="word-break: break-all;">@VAdvantage.Utility.Msg.GetMsg((string)ViewBag.culture, "Company") </p>
        @if (@Model[0].CompanyName != string.Empty && @Model[0].CompanyName != null)
        {
            if (@Model[0].CompanyName.Length > 25)
            {
                <p id="companyDetails_@ViewBag.WindowNumber" style="word-break: break-all">@Model[0].CompanyName</p>
            }
            else
            {
                <p id="companyDetails_@ViewBag.WindowNumber">@Model[0].CompanyName</p>
            }
        }
        else
        {
            <p id="companyNotFound_@ViewBag.WindowNumber" style="word-break: break-all; font-style: italic;">@VAdvantage.Utility.Msg.GetMsg((string)ViewBag.culture, "NotFound")</p>
        }


    </div>

    <div id="divRole_@ViewBag.WindowNumber" class="wsp-view_team">
        <p style="word-break: break-all;">@VAdvantage.Utility.Msg.GetMsg((string)ViewBag.culture, "RoleAssign")</p>
        @foreach (var person in Model)
        {
            if (@person.Role != string.Empty && @person.Role != null)
            {
                isRole = true;
                <p id="role_@ViewBag.WindowNumber" style="word-break: break-all">@person.Role</p>
            }

        }
        @if (!isRole)
        {
            <p id="roleNotFound_@ViewBag.WindowNumber" style="word-break: break-all; font-style: italic;">@VAdvantage.Utility.Msg.GetMsg((string)ViewBag.culture, "NotFound")</p>
        }
    </div>


</div>

