            @*<input id="@("btnLoadScheduler_" + ViewBag.WindowNumber)" type="button"  value="@VAdvantage.Utility.Msg.GetMsg((string)ViewBag.lang, "Load scheduler")" class="wsp-home-left-buttom"  />*@
