<script> 
jQuery(function() { 

 @*    
 debugger;
 var $formAppointments =   jQuery("\#@("formAppointments_" + ViewBag.WindowNumber)");   
 var $title =   jQuery("\#@("title_" + ViewBag.WindowNumber)");  *@      
  @*   $formAppointments.kendoValidator({
        rules: {
            customRule1: function(input){
              // all of the input must have a value
              //  return $.trim($title.val()) !== "";
              if (input.is("[name='Title']")) {
                return $.trim(input.val()) !== "";
              }
            }
         }
      messages: {
        customRule1: "Title fields are required",    
      }
});*@


      var $txtTaskAutocomplete = jQuery("\#@("txtSchedContacts_" + ViewBag.WindowNumber)");     
       var $divSharedContacts = jQuery("\#@("divSchedContacts_" + ViewBag.WindowNumber)");     
       var $txtContacts = jQuery("\#@("txtContacts_" + ViewBag.WindowNumber)");  
       //Bind keydown event in shared contact textbox
         var l_id=   VIS.context.getAD_User_ID();     
          $txtTaskAutocomplete.bind("keydown", function (event) {         
                if (event.keyCode === $.ui.keyCode.TAB &&
                    $(this).autocomplete("instance").menu.active) {
                    event.preventDefault();
                }
            }).autocomplete({
                minLength: 1,
                source: function (request, response) {       
                    if (request.term.trim().length ==0) {
                        return;
                    }               
                    var SharedUser= l_id;           
                    if(WSP.WspSharedUser.length>0)
                    {
                       for (var s in WSP.WspSharedUser) {
                         SharedUser += "," + WSP.WspSharedUser[s].ID;
                       }    
                    } 
                    // to get data from server using ajax request            
                    $.ajax({
                        url: VIS.Application.contextUrl + "WSP/Home/GetJsonUserInfo",
                        dataType: "json",
                        data: { "SearchKey": extractLast(request.term),"SharedUser": SharedUser},
                        success: function (result) {           
                            response($.map(JSON.parse(result.data), function (item) {
                                return {  
                                    label: item.Name,                                
                                    value: item.Name,
                                    id: item.ID
                                }
                            }));
                        }
                    });
                },    
                search: function () {
                    // custom minLength
                    var term = extractLast(this.value);
                    if (term.length < 1) {
                        return false;
                    }
                },        
               open: function( event, ui ) {
                setTimeout(function () {
                    $('.ui-autocomplete').css('z-index', 100003);
                     }, 0);
                },
                focus: function () {
                    //prevent value inserted on focus
                    return false;
                },
                 //define select handler to get selected contacts
                select: function (event, ui) {
                        var  span = $("<span>").text(ui.item.value),
                        a = $("<a  data-index='"+ui.item.id+"' id='spanRemove"+ui.item.id+ "'>").addClass("remove").attr({ href: "javascript:", title: "Remove " + ui.item.value }).text("x").appendTo(span);                         
                        //add friend to friend div
                        span.insertBefore($txtTaskAutocomplete);                                    
                        var txt_data= $txtContacts.val();
                        if(txt_data != "" && txt_data.trim().length > 0)
                        {  
                           txt_data+=","+ui.item.id;
                           $txtContacts.val(txt_data);
                        }
                        else
                        {                         
                          $txtContacts.val(ui.item.id);
                        }
                        $txtContacts.trigger("change");
                        $txtTaskAutocomplete.val("");
                        WSP.WspSharedUser.push( {ID: ui.item.id, Name:ui.item.value});  
                        return false;                 
                      },                
                 change: function() {                         
                    //prevent 'to' field being updated and correct position
                    $txtTaskAutocomplete.val("").css("top", 2);
                 }      
               });

               $divSharedContacts.find('.ui-helper-hidden-accessible').hide();               
               //add focus on shared contact div and get focus on textbox
               $divSharedContacts.click(function(){     
                  $txtTaskAutocomplete.focus();
                });
                 
              //bind click event to remove appointments      
              $divSharedContacts.on("click", function(e){                            
                 if(e.target.tagName=="A")
                 {        
                    if(l_id!= $(e.target).data('index'))    
                    {        
                       $(e.target).parent().remove();    
                    }   
                      if(WSP.WspSharedUser.length>0)
                        {                            
                           for(var j=0; j< WSP.WspSharedUser.length; j++)
                           {
                                var sid = WSP.WspSharedUser[j].ID;
                                var did = $(e.target).data('index');
                                if (sid === did) {                                
                                    var ddl_ = WSP.WspSharedUser[j].ID;
                                    var txt_ = $txtContacts.val();
                                    var res = txt_.replace(ddl_,"");
                                    $txtContacts.val(res);
                                    WSP.WspSharedUser.splice(j, 1);
                                }                      
                           }
                           $txtContacts.trigger("change");
                     } 
                   else{
                      WSP.WspSharedUser.splice(0, 1);
                     }                    
                 }
              });
              
            function split(val) {
                return val.split(/,\s*/);
            }
            function extractLast(term) {
                return split(term).pop();
            }
      });              
    <\/script> 
   

</script>


<script type="text/javascript">
    function error_handler(e) {
        if (e.errors) {
            var message = "Errors:\n";
            $.each(e.errors, function (key, value) {
                if ('errors' in value) {
                    $.each(value.errors, function () {
                        message += this + "\n";
                    });
                }
            });
            scheduler.one("dataBinding", function (e) {
                //prevent saving if server error is thrown
                e.preventDefault();
            })
        }
    }

</script>



