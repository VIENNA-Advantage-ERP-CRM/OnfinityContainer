                            </div>
                        </div>
                    </div>

                    <div class="dtd001-mi-outer-div-grids">
                        <div class="dtd001-mi-div-grid-Consume">
                            <div id="@("DTD001_GridConsm_" + ViewBag.WindowNumber)" class="dtd001-mi-grid">
                            </div>
                        </div>

                    </div>


                </div>
                <div class="dtd001-mi-div-right-bottom">
                    <button id="@("DTD001_CancelButton_" + ViewBag.WindowNumber)" class="VIS_Pref_btn-2 dtd001-mi-btn-cancel">Cancel</button>
                    <button id="@("DTD001_OkButton_" + ViewBag.WindowNumber)" class="VIS_Pref_btn-2 dtd001-mi-btn-ok">OK</button>
                </div>
            </div>
        </div>
