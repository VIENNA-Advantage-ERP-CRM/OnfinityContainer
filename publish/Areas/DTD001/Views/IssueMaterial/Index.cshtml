                        </div>
                        <div class="dtd001-mi-div-right-width50">
                            <div class="dtd001-mi-div-right-width60">

                                <input type="button" id="@("DTD001_DeleteConsumeLine_" + ViewBag.WindowNumber)" name="Delete" class="dtd001-mi-btn-delete-line" value="Delete" />
