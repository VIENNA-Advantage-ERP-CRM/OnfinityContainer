# Real per-host config with actual credentials - copy .env.example to .env
# and fill it in locally. Never commit this file.
/.env

# PostgreSQL data directory (bind-mounted by docker-compose.yml)
/data/

# Marks that the DB import already ran inside a built image layer, if ever
# extracted locally for inspection
.db-imported

# Vendored PostgreSQL client tools zip (~350MB) and VC++ redistributable
# (~25MB) - fetched by vendor/fetch-pg-client.ps1, not committed. Needed by
# `docker compose build`.
/vendor/*.zip
/vendor/*.exe
